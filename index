<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#08090d">
  <title>الفهد TV</title>
  <style>
    :root{--bg:#08090d;--panel:#12141b;--soft:#1a1d27;--text:#fff;--muted:#a7a9b2;--gold:#f2b640;--red:#e7192d;--line:rgba(255,255,255,.09)}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:Tahoma,"Segoe UI",Arial,sans-serif;min-height:100vh}button{font:inherit;color:inherit}.hidden{display:none!important}
    .app{max-width:680px;margin:auto;min-height:100vh;padding-bottom:84px;background:radial-gradient(ellipse at 85% 0,#2b1711 0%,transparent 30%),var(--bg)}
    .top{height:67px;position:sticky;top:0;z-index:15;padding:env(safe-area-inset-top) 18px 0;display:flex;align-items:center;justify-content:space-between;background:linear-gradient(#08090df5,#08090dc9,transparent);backdrop-filter:blur(12px)}
    .brand{display:flex;align-items:center;gap:9px;font-weight:900}.logo{width:38px;height:38px;border-radius:12px;display:grid;place-items:center;background:linear-gradient(135deg,#f5c95b,#b77a15);color:#160e00;font-size:22px;box-shadow:0 7px 22px #b77a1545}.actions{display:flex;gap:7px}.icon{border:0;background:#ffffff0b;border:1px solid var(--line);width:38px;height:38px;border-radius:12px;display:grid;place-items:center;font-size:19px;cursor:pointer}
    .hero{height:420px;position:relative;overflow:hidden;border-bottom:1px solid var(--line);background:linear-gradient(135deg,#3a1d10,#101722 52%,#08090d)}.hero::after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,var(--bg),transparent 62%),linear-gradient(90deg,#08090dcb,transparent 72%)}.hero-art{position:absolute;inset:0;opacity:.6;background:radial-gradient(circle at 68% 37%,#efb347 0 5%,transparent 5.3%),radial-gradient(ellipse at 76% 54%,#7d3d16 0 22%,transparent 22.5%),linear-gradient(125deg,transparent 25%,#bc701d66 25% 40%,transparent 40%);filter:blur(.2px)}
    .hero-copy{position:absolute;z-index:1;bottom:27px;right:20px;left:20px}.tag{display:inline-flex;gap:7px;align-items:center;padding:7px 10px;border:1px solid #ffffff22;border-radius:30px;background:#0006;color:#f8d88d;font-size:12px}.pulse{width:7px;height:7px;border-radius:50%;background:var(--red);box-shadow:0 0 12px var(--red)}h1{font-size:35px;margin:12px 0 7px;line-height:1.05}.hero p{margin:0 0 16px;color:#ddd;line-height:1.65;font-size:14px}.meta{display:flex;gap:12px;color:#d5d5d5;font-size:13px;align-items:center}.star{color:var(--gold);font-size:17px}.watch{border:0;border-radius:14px;background:var(--red);padding:12px 20px;font-weight:900;margin-top:16px;cursor:pointer;box-shadow:0 9px 22px #e7192d44}
    .telegram{margin:16px 12px;padding:14px;border:1px solid #2a87b9;border-radius:18px;background:linear-gradient(100deg,#09344d,#0e1b27);display:flex;gap:12px;align-items:center}.telegram i{font-style:normal;width:45px;height:45px;display:grid;place-items:center;background:#2ba4dc;border-radius:50%;font-size:23px}.telegram b{display:block;font-size:15px}.telegram small{display:block;color:#c7d2dc;margin-top:5px}.telegram button{margin-right:auto;border:0;border-radius:11px;padding:9px 14px;background:#2ba4dc;font-weight:bold;cursor:pointer}
    .section{padding:8px 12px 10px}.head{display:flex;align-items:center;justify-content:space-between;margin:12px 0 14px}.head h2{margin:0;font-size:22px}.head h2::before{content:"";display:inline-block;width:5px;height:25px;margin-left:9px;border-radius:4px;background:var(--red);vertical-align:-5px}.head button{border:0;background:transparent;color:#ed6572;cursor:pointer}
    .feature-row{display:flex;gap:10px;overflow-x:auto;padding-bottom:7px;scrollbar-width:none}.wide{min-width:215px;height:116px;border:0;border-radius:18px;overflow:hidden;position:relative;background:linear-gradient(135deg,#19445e,#12101a);cursor:pointer;text-align:right}.wide:nth-child(2){background:linear-gradient(135deg,#571a26,#1d1728)}.wide:nth-child(3){background:linear-gradient(135deg,#1b5b46,#121b1d)}.wide span{position:absolute;bottom:10px;right:11px;font-weight:900;text-shadow:0 1px 6px #000}.wide::after{content:"▶";position:absolute;left:10px;top:10px;width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:#0008;font-size:12px}
    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.card{border:0;padding:0;background:transparent;color:white;text-align:right;cursor:pointer;min-width:0}.poster{aspect-ratio:2/3;border-radius:15px;overflow:hidden;position:relative;background:#272a34}.poster::before{content:"";position:absolute;inset:0;background:linear-gradient(150deg,transparent 40%,#000b)}.poster .num{position:absolute;bottom:-12px;left:3px;font-size:62px;font-weight:900;font-style:italic;color:#fff;text-shadow:2px 2px #000;line-height:1}.poster .type{position:absolute;right:8px;top:8px;border-radius:7px;padding:4px 6px;background:#000a;font-size:10px}.p1{background:linear-gradient(150deg,#88634a,#1d2d38 65%,#101114)}.p2{background:linear-gradient(150deg,#cd8452,#593020 48%,#171112)}.p3{background:linear-gradient(150deg,#466280,#101c32 55%,#090d13)}.p4{background:linear-gradient(150deg,#603345,#251725 58%,#100b10)}.p5{background:linear-gradient(150deg,#8f7132,#2a1c11 60%,#0f0d0a)}.p6{background:linear-gradient(150deg,#3b846e,#15291f 60%,#0d120f)}.title{font-size:13px;font-weight:bold;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:7px 2px 3px}.sub{font-size:11px;color:var(--muted);margin:0 2px}
    .nav{position:fixed;z-index:30;bottom:0;right:0;left:0;max-width:680px;margin:auto;padding:9px 8px calc(9px + env(safe-area-inset-bottom));display:flex;justify-content:space-around;background:#0b0c11f2;border-top:1px solid var(--line);backdrop-filter:blur(18px)}.nav button{border:0;background:transparent;color:#8e9098;display:grid;gap:4px;place-items:center;font-size:10px;cursor:pointer}.nav i{font-size:22px;font-style:normal}.nav .active{color:var(--red)}
    .drawer,.modal{position:fixed;inset:0;z-index:50;display:none}.drawer.open,.modal.open{display:block}.backdrop{position:absolute;inset:0;background:#000a;backdrop-filter:blur(8px)}.menu{position:absolute;right:0;top:0;bottom:0;width:min(84%,360px);background:#101218;padding:calc(20px + env(safe-area-inset-top)) 17px 20px;box-shadow:-15px 0 40px #0008;animation:slide .22s ease-out}.menu-top{display:flex;align-items:center;gap:11px;padding-bottom:20px;border-bottom:1px solid var(--line);font-size:20px;font-weight:900}.menu-logo{width:52px;height:52px;border-radius:16px;display:grid;place-items:center;background:linear-gradient(135deg,#f5c95b,#b77a15);color:#160e00;font-size:29px}.mi{width:100%;border:0;background:transparent;display:flex;align-items:center;gap:16px;padding:15px 8px;text-align:right;font-size:17px;cursor:pointer}.mi i{font-size:21px;font-style:normal;width:27px;text-align:center}.mi:hover{background:#ffffff08;border-radius:11px}.divider{height:1px;background:var(--line);margin:11px 0}@keyframes slide{from{transform:translateX(100%)}to{transform:none}}
    .dialog{position:absolute;right:16px;left:16px;top:50%;transform:translateY(-50%);border-radius:25px;padding:29px 22px;text-align:center;background:#1c1d20;box-shadow:0 22px 60px #000a}.dialog .warn{font-size:44px}.dialog h3{font-size:27px;margin:10px 0 18px}.dialog p{color:#c8c8ca;line-height:2;font-size:15px;margin:0 0 24px}.dialog button{width:100%;border:0;border-radius:14px;padding:14px;background:var(--red);font-size:18px;font-weight:900;cursor:pointer}
    @media(min-width:681px){body{background:#040508}.app{box-shadow:0 0 80px #000}.hero{border-radius:0 0 28px 28px}}
  </style>
</head>
<body>
  <div class="app">
    <header class="top"><div class="brand"><span class="logo">🐆</span><span>الفهد TV</span></div><div class="actions"><button class="icon" aria-label="المفضلة">♡</button><button class="icon" aria-label="الإشعارات">♧</button><button class="icon" onclick="toggleMenu()" aria-label="القائمة">☰</button></div></header>
    <section class="hero"><div class="hero-art"></div><div class="hero-copy"><span class="tag"><i class="pulse"></i> مختارات الفهد</span><h1>ليلة في المدينة</h1><p>دراما مشوقة في تجربة مشاهدة سريعة ومصممة لهاتفك.</p><div class="meta"><span>2026</span><span>•</span><span>دراما</span><span class="star">★ 8.4</span></div><button class="watch" onclick="showToast('تم تجهيز صفحة المشاهدة التجريبية')">▶ شاهد الآن</button></div></section>
    <aside class="telegram"><i>➤</i><div><b>قناة الفهد الجديدة</b><small>تابع أحدث الإضافات والإعلانات على تيليجرام</small></div><button onclick="showToast('سيتم إضافة رابط القناة')">اشترك</button></aside>
    <section class="section"><div class="head"><h2>مقترح لك</h2><button>عرض الكل</button></div><div class="feature-row"><button class="wide"><span>أفلام عربية جديدة</span></button><button class="wide"><span>مسلسلات حصرية</span></button><button class="wide"><span>أقوى الأنمي</span></button></div></section>
    <section class="section"><div class="head"><h2>أفلام رائجة</h2><button>عرض الكل</button></div><div class="grid" id="movieGrid"></div></section>
    <section class="section"><div class="head"><h2>مسلسلات تستحق المشاهدة</h2><button>عرض الكل</button></div><div class="grid" id="seriesGrid"></div></section>
  </div>
  <nav class="nav"><button class="active"><i>⌂</i>الرئيسية</button><button onclick="showToast('قسم المسلسلات قريبًا')"><i>▣</i>المسلسلات</button><button onclick="showToast('قسم الأفلام قريبًا')"><i>▰</i>الأفلام</button><button onclick="showToast('قسم القنوات قريبًا')"><i>▻</i>القنوات</button><button onclick="showToast('ابحث في مكتبة الفهد')"><i>⌕</i>بحث</button></nav>
  <div class="drawer" id="drawer"><div class="backdrop" onclick="toggleMenu()"></div><aside class="menu"><div class="menu-top"><span class="menu-logo">🐆</span><span>الفهد TV</span></div><button class="mi"><i>⌂</i>الرئيسية</button><button class="mi"><i>▣</i>المسلسلات</button><button class="mi"><i>▰</i>الأفلام</button><button class="mi"><i>◉</i>الأنمي</button><button class="mi"><i>▻</i>القنوات</button><button class="mi"><i>⚽</i>مباريات اليوم</button><div class="divider"></div><button class="mi"><i>⌕</i>البحث</button><button class="mi"><i>♡</i>المفضلة</button><button class="mi" onclick="openDialog('about')"><i>⚙</i>الإعدادات</button><div class="divider"></div><button class="mi" onclick="openDialog('disclaimer')"><i>⚠</i>إخلاء المسؤولية</button><button class="mi"><i>↗</i>مشاركة التطبيق</button></aside></div>
  <div class="modal" id="modal"><div class="backdrop" onclick="closeDialog()"></div><article class="dialog"><div class="warn" id="dialogIcon">⚠</div><h3 id="dialogTitle"></h3><p id="dialogText"></p><button onclick="closeDialog()">حسنًا</button></article></div>
  <script>
    const movies=['الممر الأخير','خيط من ذهب','صدى المدينة','موعد سري','رسالة إلى الغد','أرض العجائب'];
    const series=['قصة لم تكتمل','نبض الليل','الطريق الطويل','على حافة الحلم','أيام لا تنسى','ورد وبارود'];
    function cards(items, numbered=false){return items.map((name,i)=>`<button class="card" onclick="showToast('صفحة ${name} التجريبية')"><div class="poster p${i%6+1}"><span class="type">${numbered?'فيلم':'مسلسل'}</span>${numbered?`<b class="num">${i+1}</b>`:''}</div><div class="title">${name}</div><div class="sub">${numbered?'2026 • ★ 8.1':'الحلقة الجديدة متاحة'}</div></button>`).join('')}
    document.querySelector('#movieGrid').innerHTML=cards(movies,true);document.querySelector('#seriesGrid').innerHTML=cards(series);
    function toggleMenu(){document.querySelector('#drawer').classList.toggle('open')}
    function openDialog(kind){toggleMenu();const about=kind==='about';document.querySelector('#dialogIcon').textContent=about?'🐆':'⚠';document.querySelector('#dialogTitle').textContent=about?'عن تطبيق الفهد TV':'إخلاء المسؤولية';document.querySelector('#dialogText').textContent=about?'الفهد TV يقدم لك واجهة مشاهدة سريعة وسهلة للاستخدام، بتصميم مخصص للموبايل وتحديثات مستمرة.':'يعرض التطبيق المحتوى الذي تملك حقوق عرضه أو المصرح لك باستخدامه فقط. يجب ربط هذه الواجهة بمصادر محتوى قانونية ومرخصة.';document.querySelector('#modal').classList.add('open')}
    function closeDialog(){document.querySelector('#modal').classList.remove('open')}
    function showToast(message){const el=document.createElement('div');el.textContent=message;el.style.cssText='position:fixed;z-index:70;bottom:95px;right:50%;transform:translateX(50%);background:#25262b;color:white;padding:12px 18px;border-radius:13px;box-shadow:0 9px 28px #0008;font-weight:bold;white-space:nowrap';document.body.append(el);setTimeout(()=>el.remove(),2300)}
  </script>
</body>
</html>
